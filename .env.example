# Google Sign-In Credentials
# Web Client ID (from Firebase Console -> Authentication -> Sign-in method -> Google, or Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# iOS Client ID (from Google Cloud Console -> Credentials -> iOS Client ID, or GoogleService-Info.plist CLIENT_ID)
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
